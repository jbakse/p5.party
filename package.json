{
  "name": "p5.party",
  "version": "0.15.0",
  "author": "Justin Bakse",
  "license": "MIT",
  "description": "Pre-release! An easy to use library for simple multi-user sketches with p5.js.",
  "keywords": [
    "p5",
    "multiuser",
    "multiplayer",
    "library"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "types",
    "docs/api.md"
  ],
  "main": "dist/p5.party.js",
  "module": "dist/p5.party.mjs",
  "types": "types/p5.party.d.ts",
  "exports": {
    ".": {
      "types": "./types/p5.party.d.ts",
      "import": "./dist/p5.party.mjs",
      "default": "./dist/p5.party.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./types/*": "./types/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jbakse/p5.party.git"
  },
  "scripts": {
    "start": "npm run esbuild -- --watch --outfile=public/dist/p5.party.js ",
    "test": "jest --coverage",
    "test:unit": "jest --coverage=false --testPathIgnorePatterns Record.test Room.test guestShareds.test",
    "release": "np",
    "serve": "PORT=${PORT:-6020} deepstream start",
    "netlify": "npm run esbuild -- --outfile=public/dist/p5.party.js",
    "-------------": "--",
    "prestart": "npm run genversion",
    "!posttest": "istanbul-badges-readme",
    "prenetlify": "npm run genversion",
    "prebuild": "npm run genversion",
    "build": "npm run esbuild -- --outfile=dist/p5.party.js --loader:.css=text && npm run esbuild:esm -- --outfile=dist/p5.party.mjs && npm run build:types && npm run docs",
    "prerelease": "npm run build",
    "prepublishOnly": "npm run build",
    "postpublish": "curl https://purge.jsdelivr.net/npm/p5.party@latest/dist/p5.party.js",
    "genversion": "genversion --es6 --semi version.js",
    "esbuild": "esbuild src/p5.party.ts --bundle --sourcemap --minify --target=es6 --define:global=window --inject:esbuild.inject.js --loader:.css=text",
    "test:types": "tsc -p test-types",
    "build:types": "tsc -p tsconfig.types.json && mv types/types.d.ts types/p5.party.d.ts",
    "esbuild:esm": "esbuild src/index.ts --bundle --sourcemap --minify --format=esm --target=es2017 --define:global=window --inject:esbuild.inject.js --loader:.css=text",
    "docs": "node scripts/build-api-docs.mjs"
  },
  "dependencies": {
    "@deepstream/client": "^5.2.6",
    "@deepstream/server": "^5.2.6",
    "ts-dedent": "^2.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/reefjs": "^7.6.1",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.16.0",
    "eslint-config-p5js": "^1.1.0",
    "genversion": "^3.0.2",
    "istanbul-badges-readme": "^1.8.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "np": "^10.0.1",
    "on-change": "^5.0.0",
    "reefjs": "^13.0.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2"
  }
}
